<?xml version="1.0" encoding="utf-8"?>
<!-- HttpURLConnection obeys this file; Dart's HTTP stack does not read it.
     Cleartext stays refused everywhere except the home development host, where
     a dev personal-agent has no TLS (ADR-PLATFORM-009). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">laptop.lan</domain>
    </domain-config>
</network-security-config>
