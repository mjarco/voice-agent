<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below. Positions stay off the phone's cloud backup; everything else keeps its default. -->
<full-backup-content>
    <exclude domain="database" path="location_log.db"/>
    <exclude domain="database" path="location_log.db-wal"/>
    <exclude domain="database" path="location_log.db-shm"/>
    <exclude domain="sharedpref" path="location_log.xml"/>
    <exclude domain="sharedpref" path="geofences.xml"/>
</full-backup-content>
